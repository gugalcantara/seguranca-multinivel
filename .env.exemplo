# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Conta da APLICAÇÃO no MySQL (não usar root — ETP 6.4: separar conta da aplicação da administrativa)
DB_HOST=127.0.0.1
# ATENÇÃO À PORTA: 3307 se o MySQL vier do docker-compose.yml deste projeto
# (ele publica 3307 no host de propósito, para não colidir com um MySQL já
# instalado); 3306 se você usa um MySQL próprio, XAMPP ou WAMP.
DB_PORTA=3307
DB_NOME=aps_pivc
DB_USUARIO=aps_app
DB_SENHA=troque-esta-senha

# Banco DESCARTÁVEL usado pelos testes de integração. A suíte cria e recria o
# schema dele a cada execução, então o banco de demonstração acima nunca recebe
# usuários nem trilha de teste. Sem esta variável, os testes de banco são PULADOS.
DB_NOME_TESTE=aps_pivc_teste

# Chave Fernet para cifrar o modelo LBPH e as fotos de tentativas negadas em repouso.
# Gere com:  python -m ferramentas gerar-chave
CHAVE_CIFRAGEM=

# Hash bcrypt da senha do administrador (protege o módulo de cadastro).
# Gere com:  python -m ferramentas hash-admin
ADMIN_SENHA_HASH=
